# BASIS/config/bot.env (Besitzer BENUTZER, 0600) — nie ins Repo, nie ins Buch.
# Meist trägt man das in aeradex ein (Einstellungen › Agent & KI › Telegram-Agent › Zugänge); diese Datei ist der Weg
# von Hand. setup.sh legt sie mit PUBLIC_URL, Backend und LLM_SHARED_SECRET an.

PUBLIC_URL=https://buch.example.ch           # Adresse des Buchs: für die Telegram Mini App und den Anruf (ElevenLabs)
LLM_SHARED_SECRET=                           # zufällig (openssl rand -hex 32): ElevenLabs → Gateway, Bearer

# Welches Modell der Bot und der Anruf benutzen
AERADEX_ANRUF_BACKEND=api                    # api (ANTHROPIC_API_KEY in anthropic.env) | openai (z.B. Gemini) | claude-code
AERADEX_ANRUF_WERKZEUGE=entwuerfe            # entwuerfe: Buchungen nur als Vorschlag, ein Mensch bestätigt
# OpenAI-kompatible Schnittstelle, z.B. Gemini (auch für Sprachnachrichten, wenn ElevenLabs fehlt)
AERADEX_OPENAI_BASE_URL=                     # Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
AERADEX_OPENAI_API_KEY=
AERADEX_OPENAI_MODEL=

# Wie der Agent heisst und wen er anspricht
AERADEX_ANRUF_NAME=Susi
AERADEX_ANRUF_CHEF=                          # Vorname der Person, für die er arbeitet

# Telegram-Bot (Token von @BotFather; Telegram-IDs z.B. von @userinfobot): nur diese Personen dürfen mit ihm reden
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Sprache: ElevenLabs für Sprachnachrichten, gesprochene Antworten, den Anruf und das Mikrofon im Browser
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=                         # legt «aeradex anruf elevenlabs-setup» an
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=
